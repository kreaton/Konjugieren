    private static readonly string[] Ich = ["ich", "du", "er/sie/es", "wir", "ihr", "sie/Sie"];
    private static readonly string[] Imp = ["(du)", "(ihr)", "(Sie)"];

    // "mach|te" = stem + ending; the ending is shown in bold.
    private static string Stem(string f) => f.Split('|')[0];
    private static string Ending(string f) => f.Contains('|') ? f.Split('|')[1] : "";

    private static string[][] Rows(params string[][] persons) => persons;

    private static readonly GuideMood[] Moods =
    [
        new("indikativ", "Indikativ", "indicative",
